{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=El1teSpr1ntTrack;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "El1teSpr1ntTrack.Api",
    "Audience": "El1teSpr1ntTrack.Web",
    "ExpiresMinutes": 60
  },
  "AuthFeatures": {
    "AllowPublicRegistration": false,
    "FailedLoginLimit": 5,
    "FailedLoginWindowMinutes": 15,
    "LockoutMinutes": 15,
    "PasswordResetMinutes": 30,
    "MfaMinutes": 10,
    "MfaMaximumAttempts": 5
  },
  "TransactionalEmail": {
    "Provider": "DevelopmentFile",
    "SenderAddress": "DoNotReply@localhost",
    "DevelopmentOutboxPath": ".dev-mail",
    "AdminSiteUrl": "http://localhost:3000"
  },
  "MediaStorage": {
    "Provider": "Local",
    "LocalRoot": "uploads",
    "PublicBaseUrl": "http://localhost:5126",
    "MaxFileSizeBytes": 10485760
  },
  "AdminInvitations": {
    "SiteUrl": "http://localhost:3000",
    "ExpiresHours": 72
  },
  "Store": {
    "Enabled": false,
    "CheckoutEnabled": false,
    "Currency": "USD",
    "ReservationMinutes": 30,
    "DefaultLowStockThreshold": 3,
    "OutboxPollSeconds": 5,
    "ReconciliationMinutes": 5,
    "PublicSiteUrl": "http://localhost:3000"
  },
  "Square": {
    "Environment": "Sandbox",
    "ApiVersion": "2026-07-15",
    "RequestTimeoutSeconds": 15
  },
  "Serilog": {
    "SeqUrl": ""
  }
}
